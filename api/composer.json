{
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.3.17",
        "api-platform/symfony": "^4.3.17",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.7",
        "gedmo/doctrine-extensions": "^3.22",
        "guzzlehttp/psr7": "^2.0",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3.3",
        "spomky-labs/aes-key-wrap": "^7.0",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^8.1",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/yaml": "^8.1",
        "web-token/jwt-bundle": "^4.1.7",
        "web-token/jwt-library": "^4.1.7",
        "ext-uri": "*"
    },
    "require-dev": {
        "api-platform/schema-generator": "^5.2.5",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "php-coveralls/php-coveralls": "^v2.9.1",
        "phpunit/phpunit": "^13.2.6",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.67",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/web-profiler-bundle": "^8.1",
        "zenstruck/foundry": "^2.11"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1",
            "docker": false
        }
    }
}
