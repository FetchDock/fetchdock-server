{% extends 'privacy_page/base.html.twig' %}
{# revision: PrivacyPolicyRevision|null (preview), html: string|null (preview), isCurrent, outdated, currentUrl, preview #}
{% block title %}{{ preview ? 'Preview: privacy policy' : 'Privacy policy' }}{% if revision %} (revision {{ revision.number }}){% endif %}{% endblock %}
{% block body %}
{% if preview %}
<p class="note">Preview of the generated privacy policy from the saved answers. It is not published.</p>
{% elseif isCurrent and outdated|default(false) %}
<p class="note"><strong>Update pending review:</strong> This instance has been updated since this privacy policy was last reviewed by its operator, so some details may not yet reflect the latest software or configuration changes. The operator has been notified to review and publish an updated policy.</p>
{% elseif not isCurrent %}
<p class="note">This is revision {{ revision.number }} of {{ revision.createdAt|date('Y-m-d', 'UTC') }}, an earlier version of this instance's privacy policy.{% if currentUrl %} <a href="{{ currentUrl }}">Read the current policy</a>.{% else %} The instance publishes no current policy.{% endif %}</p>
{% endif %}
{{ (revision ? revision.html : html)|raw }}
{% if revision %}
<footer>
<p>Revision {{ revision.number }} of {{ revision.createdAt|date('Y-m-d H:i', 'UTC') }} UTC. Generated by FetchDock {{ revision.appVersion }} from policy text version {{ revision.textVersion }}.</p>
{% set otherRevisions = revisions|default([])|filter(r => r.number != revision.number) %}
{% if otherRevisions is not empty %}
<details class="revisions">
<summary>{{ isCurrent ? 'Previous revisions' : 'Other revisions' }} ({{ otherRevisions|length }})</summary>
<ul>
{% for entry in otherRevisions %}
<li><a href="{{ path('app_privacy_policy', { revision: entry.number }) }}">Revision {{ entry.number }}</a> — {{ entry.createdAt|date('Y-m-d H:i', 'UTC') }} UTC (FetchDock {{ entry.appVersion }}, policy text {{ entry.textVersion }})</li>
{% endfor %}
</ul>
</details>
{% endif %}
</footer>
{% endif %}
{% endblock %}
